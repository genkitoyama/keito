{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the keito window may use: its own commands, dialogs, opening links, the clipboard.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "dialog:allow-ask",
    "dialog:allow-message",
    "opener:allow-open-url",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-write-image"
  ]
}
