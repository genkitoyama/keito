{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "keito",
  "version": "0.1.1",
  "identifier": "dev.keito.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5184",
    "beforeDevCommand": "npx vite --port 5184 --strictPort",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "keito",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: keito-asset: http://keito-asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost data: blob: keito-asset: http://keito-asset.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "category": "Productivity",
    "shortDescription": "テクニカルディレクター向けの系統図ツール",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true
    }
  }
}
